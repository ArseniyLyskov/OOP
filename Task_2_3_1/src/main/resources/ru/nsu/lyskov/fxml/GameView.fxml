<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
			fx:controller="ru.nsu.lyskov.controllers.GameController"
			stylesheets="@../styles/style.css"
			prefWidth="800" prefHeight="600">

	<top>
		<BorderPane styleClass="top-bar">
			<left>
				<HBox alignment="CENTER_LEFT">
					<Button fx:id="startButton" text="▶ Play"
							onAction="#onStart"
							styleClass="play-button"/>
					<Label text="Score:" styleClass="static-label"/>
					<Label fx:id="scoreLabel" text="0" styleClass="score-label"/>
				</HBox>
			</left>

			<right>
				<Label fx:id="statusLabel"
					   visible="false"
					   styleClass="status-label"/>
			</right>
		</BorderPane>
	</top>

	<center>
		<StackPane>
			<Canvas fx:id="gameCanvas"
					width="600" height="500"
					StackPane.alignment="CENTER"/>
		</StackPane>
	</center>

</BorderPane>
